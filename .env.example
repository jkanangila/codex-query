LOG_LEVEL = INFO
# Models
LLM_MODEL=qwen2.5-coder:1.5b
EMBEDDING_MODEL=nomic-embed-text

# Processing & Retrieval Settings
CHUNK_CHARS=1800
CHUNK_OVERLAP=250
BATCH_SIZE=8
RETRIEVAL_K=6

# Resolve wsl host ip and replace it for ollama
_OPT_IN_ENV=1

BOOKS_DIR = /mnt/d/SharedFolder/Epubs/The Mech Touch/
# Optional/Path Overrides (if set via environment)
# DATA_DIR=/path/to/data
# OLLAMA_HOST=http://127.0.0.1:11434
